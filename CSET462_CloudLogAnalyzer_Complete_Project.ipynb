      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Modern plot configuration\n",
        "plt.style.use(\"seaborn-v0_8-whitegrid\" if \"seaborn-v0_8-whitegrid\" in plt.style.available else \"default\")\n",
        "fig = plt.figure(figsize=(15, 12))\n",
        "\n",
        "# 1. Incident Severity Donut\n",
        "ax1 = plt.subplot2grid((2, 2), (0, 0))\n",
        "sev_counts = {\"CRITICAL\": 0, \"HIGH\": 0, \"MEDIUM\": 0, \"LOW\": 0}\n",
        "for inc in incidents:\n",
        "    s = inc.get(\"severity\", \"LOW\")\n",
        "    sev_counts[s] = sev_counts.get(s, 0) + 1\n",
        "labels = [k for k, v in sev_counts.items() if v > 0]\n",
        "sizes = [sev_counts[k] for k in labels]\n",
        "colors = {\"CRITICAL\": \"#e63946\", \"HIGH\": \"#f4a261\", \"MEDIUM\": \"#e9c46a\", \"LOW\": \"#2a9d8f\"}\n",
        "ax1.pie(sizes, labels=labels, autopct=\"%1.1f%%\", startangle=140,\n",
        "        colors=[colors[l] for l in labels],\n",
        "        wedgeprops=dict(width=0.4, edgecolor=\"white\", linewidth=2))\n",
        "ax1.set_title(\"Threat Incidents by Severity\", fontsize=13, fontweight=\"bold\")\n",
        "\n",
        "# 2. Service Activity Breakdown\n",
        "ax2 = plt.subplot2grid((2, 2), (0, 1))\n",
        "ct = pd.crosstab(df[\"eventSource\"], df[\"status\"])\n",
        "ct.plot(kind=\"bar\", stacked=True, ax=ax2,\n",
        "        color={\"Success\": \"#2a9d8f\", \"Failed\": \"#f4a261\", \"Unauthorized\": \"#e63946\"},\n",
        "        edgecolor=\"white\")\n",
        "ax2.set_title(\"Cloud Service Activity by Status\", fontsize=13, fontweight=\"bold\")\n",
        "ax2.set_xlabel(\"Service\", fontweight=\"bold\")\n",
        "ax2.set_ylabel(\"Count\", fontweight=\"bold\")\n",
        "plt.sca(ax2)\n",
        "plt.xticks(rotation=0)\n",
        "\n",
        "# 3. MITRE ATT&CK Breakdown\n",
        "ax3 = plt.subplot2grid((2, 2), (1, 0))\n",
        "techniques = [inc.get(\"mitre_technique\", \"Unknown\") for inc in incidents]\n",
        "t_series = pd.Series(techniques).value_counts().sort_values(ascending=True)\n",
        "ax3.barh(t_series.index, t_series.values, color=\"#1d3557\", edgecolor=\"white\")\n",
        "ax3.set_title(\"Detected Threats (MITRE ATT&CK)\", fontsize=13, fontweight=\"bold\")\n",
        "ax3.set_xlabel(\"Occurrences\", fontweight=\"bold\")\n",
        "\n",
        "# 4. Timeline\n",
        "ax4 = plt.subplot2grid((2, 2), (1, 1))\n",
        "df_ts = df.copy().set_index(\"eventTime\")\n",
        "tot_ts = df_ts[\"eventName\"].resample(\"6h\").count()\n",
        "fail_ts = df_ts[df_ts[\"is_failed\"]][\"eventName\"].resample(\"6h\").count().reindex(tot_ts.index, fill_value=0)\n",
        "ax4.plot(tot_ts.index, tot_ts.values, label=\"Total Events\", color=\"#457b9d\", lw=2)\n",
        "ax4.plot(fail_ts.index, fail_ts.values, label=\"Malicious/Failed Spikes\", color=\"#e63946\", lw=2.5, linestyle=\"--\")\n",
        "ax4.fill_between(fail_ts.index, fail_ts.values, color=\"#e63946\", alpha=0.25)\n",
        "ax4.set_title(\"Event Timeline & Attack Spikes (6h)\", fontsize=13, fontweight=\"bold\")\n",
        "ax4.set_xlabel(\"Timestamp\", fontweight=\"bold\")\n",
        "ax4.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
    },
